# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
APP_ENV=dev
FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Clerk security
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
MAX_REQUEST_MB=30
MAX_XRAY_MB=20

# Models and inference
OPENAI_API_KEY=sk-proj-...
SUPERVISOR_LLM=gpt-4o
FAST_LLM=gpt-4o-mini
HAND_MODEL_PATH=models/hand_yolo.pt
LEG_MODEL_PATH=models/leg_yolo.pt
ROUTER_THRESHOLD=0.70
DETECTOR_SCORE_MIN=0.35
NMS_IOU=0.50
TRIAGE_RED_THRESHOLD=0.80
TRIAGE_AMBER_THRESHOLD=0.60

# MongoDB and private local storage
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/orthoassist?retryWrites=true&w=majority
MONGODB_DB_NAME=orthoassist
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Optional tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=orthoassist-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Runtime guards
SECRET_KEY=replace_with_a_long_random_secret
PHI_REDACTION_ENABLED=true
MEDICAL_DISCLAIMER_ENABLED=true
MAX_AGENT_ITERATIONS=10
SESSION_TTL_SECONDS=3600
MULTI_AGENT_ENABLED=false
